{
  "id": "ExpRecurring0001",
  "name": "Recurring",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta"
  },
  "pinData": {},
  "nodes": [
    {
      "name": "Daily 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "name": "On start",
      "type": "n8n-nodes-base.n8nTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ],
      "parameters": {
        "events": [
          "init"
        ]
      }
    },
    {
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        500
      ],
      "parameters": {}
    },
    {
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sheetId",
              "name": "sheetId",
              "value": "YOUR_SHEET_ID",
              "type": "string"
            },
            {
              "id": "chatId",
              "name": "chatId",
              "value": "YOUR_CHAT_ID",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Rules",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true,
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Recurring"
        },
        "operation": "read",
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PLACEHOLDER",
          "name": "Google Sheets"
        }
      }
    },
    {
      "name": "Due?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": [
          "//@include recurring.js",
          "// The rules run inside Process Inbox, one message at a time, so the entry ids and /undo cannot race a",
          "// message that is being processed. This workflow only puts \"/recurring run\" in the queue, and only",
          "// when a rule is due (or broken), so a normal day stays silent.",
          "const now = new Date();",
          "const rules = $input.all().map((i) => i.json).filter((r) => r.id); // an empty tab gives one {} item",
          "if (!recurringPending(rules, now.toISOString())) return [];",
          "const stamp = new Date(now.getTime() + 7 * 3600000).toISOString().slice(0, 19) + '+07:00';",
          "return [{",
          "  json: {",
          "    update_id: 'R' + now.getTime(), // Telegram ids are plain numbers, so this never collides",
          "    received_at: stamp,",
          "    msg_date: stamp,",
          "    chat_id: String($('Config').first().json.chatId),",
          "    kind: 'command',",
          "    text: '/recurring run',",
          "    file_id: '',",
          "    status: 'new',",
          "    error: '',",
          "    processed_at: '',",
          "  },",
          "}];"
        ]
      }
    },
    {
      "name": "Queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        880,
        300
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Inbox"
        },
        "operation": "append",
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {
          "cellFormat": "RAW",
          "handlingExtraData": "ignoreIt"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PLACEHOLDER",
          "name": "Google Sheets"
        }
      }
    }
  ],
  "connections": {
    "Daily 07:00": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "On start": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Rules",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rules": {
      "main": [
        [
          {
            "node": "Due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Due?": {
      "main": [
        [
          {
            "node": "Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
