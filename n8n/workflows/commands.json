    {
      "name": "Run command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": [
          "//@include messages.js",
          "//@include commands.js",
          "const inbox = $('Start').first().json;",
          "// A retried /undo would void one more batch, so an interrupted command is never re-run.",
          "if (inbox.retry) throw new Error('it was interrupted and may already have run; check /balance first');",
          "const transactions = $('Transactions').all().map((i) => i.json).filter((t) => t.id); // empty tab gives one {} item",
          "const idNum = (t) => parseInt(String(t.id).replace(/\\D/g, ''), 10) || 0;",
          "const result = runCommand({",
          "  text: inbox.text,",
          "  transactions,",
          "  accounts: $('Accounts').all().map((i) => i.json),",
          "  categories: $('Categories').all().map((i) => i.json).filter((c) => c.id),",
          "  nextIdNum: transactions.reduce((n, t) => Math.max(n, idNum(t)), 0) + 1,",
          "  inbox,",
          "  now: new Date().toISOString(),",
          "});",
          "return [{ json: { inbox, ...result } }];"
        ]
      }
    }
  ],
