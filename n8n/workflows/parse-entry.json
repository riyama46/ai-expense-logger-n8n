      ],
      "parameters": {}
    },
    {
      "name": "LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1980,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {
          "timeout": 45000
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "PLACEHOLDER",
          "name": "OpenAI"
        }
      }
    },
    {
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "jsCode": [
          "//@include messages.js",
          "//@include validate.js",
          "const inbox = $('Start').first().json;",
          "const content = $input.first().json.choices[0].message.content;",
          "if (!content) throw new Error('the AI service returned no answer');",
          "const idNum = (i) => parseInt(String(i.json.id || '').replace(/\\D/g, ''), 10) || 0;",
          "// Retry of an interrupted run: the rows may already be in the Sheet. Never write them twice.",
          "const saved = $('Transactions').all().map((i) => i.json).filter((t) => t.id && String(t.inbox_update_id) === String(inbox.update_id));",
          "if (saved.length) return [{ json: { inbox, ok: true, rows: [], reply: MSG.saved(saved, $('Categories').all().map((i) => i.json)) } }];",
          "const result = validateParse({",
          "  parsed: JSON.parse(content),",
          "  inbox,",
          "  categories: $('Categories').all().map((i) => i.json),",
          "  accounts: $('Accounts').all().map((i) => i.json),",
          "  transactions: $('Transactions').all().map((i) => i.json).filter((t) => t.id),",
          "  nextIdNum: $('Transactions').all().reduce((n, i) => Math.max(n, idNum(i)), 0) + 1,",
          "  now: new Date().toISOString(),",
          "});",
          "return [{ json: { inbox, ...result } }];"
        ]
      }
    }
