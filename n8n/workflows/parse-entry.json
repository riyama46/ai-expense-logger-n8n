    {
      "name": "To base64",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "operation": "binaryToPropery",
        "destinationKey": "image",
        "options": {}
      }
    },
    {
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "jsCode": [
          "//@include prompt.js",
          "//@include image.js",
          "//@include messages.js",
          "const inbox = $('Start').first().json;",
          "const state = $('State').all().find((i) => i.json.key === 'llm_model');",
          "const model = String((state && state.json.value) || '');",
          "if (!model || model === 'SET_ME') throw new Error('State.llm_model is not set');",
          "const image = $input.first().json.image; // set only on the photo path",
          "// a scrolling screenshot is unreadable after Telegram's resize: say so instead of saving guessed rows",
          "if (image && imageTooLong(imageJpegSize(image))) return [{ json: { inbox, ok: false, rows: [], reply: MSG.photoTooLong() } }];",
          "const body = buildLlmRequest({",
          "  kind: inbox.kind,",
          "  text: inbox.text,",
          "  imageDataUrl: image ? 'data:image/jpeg;base64,' + image : undefined, // Telegram serves photos as JPEG",
          "  msgDate: inbox.msg_date,",
          "  categories: $('Categories').all().map((i) => i.json),",
          "  accounts: $('Accounts').all().map((i) => i.json),",
          "  model,",
          "});",
          "return [{ json: { body } }];"
        ]
      }
    },
    {
      "name": "Has request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        1870,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "has-request",
              "leftValue": "={{ !!$json.body }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Rejected",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1980,
