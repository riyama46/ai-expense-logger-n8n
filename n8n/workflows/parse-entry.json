    {
      "name": "Is photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        1100,
        300
      ],
      "executeOnce": true,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "is-photo",
              "leftValue": "={{ $('Start').first().json.kind }}",
              "rightValue": "photo",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
