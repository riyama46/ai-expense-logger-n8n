    {
      "name": "Pick",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        320
      ],
      "parameters": {
        "jsCode": [
          "// A run that started more than STALE_MS ago was interrupted (n8n stopped); its rows are picked up again.",
          "const STALE_MS = 30 * 60000;",
          "const MAX_ROWS = 5; // worst case 5 x (3 LLM tries x 45 s) is about 12 min, well under STALE_MS",
          "// The claim (Mark processing) is a plain Sheet write, not atomic. It must land before the next",
          "// minute's run reads the Inbox, so a run that starts late (n8n catches up a missed tick after a",
          "// restart) leaves the rows to the next run instead of racing it.",
          "const LATE_MS = 30000;",
          "const now = Date.now();",
          "const config = $('Config').first().json;",
          "const tick = Date.parse($('Every minute').first().json.timestamp);",
          "// Lateness is measured where the run started (Config), not here: a slow Read Inbox is not a late run.",
          "// CLAIM_MS still stops a run whose claim could not land before the next run reads.",
          "const CLAIM_MS = 50000;",
          "if ((Number(config.startedAt) || now) - tick > LATE_MS || now - tick > CLAIM_MS) return [];",
          "const rows = $input.all().map((i) => i.json).sort((a, b) => a.row_number - b.row_number);",
          "// One run at a time: a recent 'processing' row means another run still owns the queue (ids, /undo).",
          "if (rows.some((r) => r.status === 'processing' && now - Date.parse(r.processed_at) < STALE_MS)) return [];",
          "const stamp = new Date(now + 7 * 3600000).toISOString().slice(0, 19) + '+07:00';",
          "return rows.slice(0, MAX_ROWS).map((r) => ({ json: { ...r, retry: r.status === 'processing', status: 'processing', processed_at: stamp, config } }));"
        ]
      }
    },
