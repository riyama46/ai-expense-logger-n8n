    {
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        520
      ],
      "parameters": {
        "jsCode": [
          "//@include messages.js",
          "const j = $input.first().json;",
          "// Success: the sub-workflow returns {inbox, ...}. Error output: the Loop item's fields plus `error`.",
          "const inbox = j.inbox || j;",
          "const err = j.inbox ? '' : String(j.error || 'unknown error');",
          "const m = {",
          "  update_id: inbox.update_id,",
          "  status: err ? 'error' : 'done',",
          "  error: err,",
          "  processed_at: new Date(Date.now() + 7 * 3600000).toISOString().slice(0, 19) + '+07:00',",
          "  reply: err ? MSG.error(inbox.text, err.slice(0, 120)) : j.reply,",
          "  input_text: inbox.text,",
          "};",
          "// /undo and /ok only change the status cell of existing rows",
          "const voids = [...(j.voidIds || []).map((id) => ({ id, status: 'void' })), ...(j.okIds || []).map((id) => ({ id, status: 'ok' }))];",
          "const writes = err ? [] : [...(j.rows || j.appendRows || []), ...voids];",
          "return writes.length ? writes.map((w) => ({ json: { ...w, _m: m } })) : [{ json: m }];"
        ]
      }
